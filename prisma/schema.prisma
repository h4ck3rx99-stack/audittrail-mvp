// AuditTrail data model.
//
// Conventions
// - IDs are UUIDv7 strings (non-sequential, unguessable, time-ordered).
// - Every tenant-owned row carries organizationId; composite indexes lead with it.
// - Join tables use composite foreign keys (organizationId, id) so a row can never point at a
//   resource from another tenant, even if application code were wrong.
// - Compliance records are never hard-deleted (archivedAt / deletedAt). Relations use
//   onDelete: Restrict. Nothing cascades into AuditEvent, which has no foreign keys at all.
// - Date-only domain fields (due dates, review dates, validity) use @db.Date.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum EmployeeRange {
  R1_10
  R11_50
  R51_200
  R201_500
  R501_1000
  R1000_PLUS
}

enum AuditType {
  TYPE_1
  TYPE_2
  UNDECIDED
}

enum RequirementKind {
  GROUP
  REQUIREMENT
}

enum ControlStatus {
  NOT_STARTED
  IN_PROGRESS
  IMPLEMENTED
  NOT_APPLICABLE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewFrequency {
  MONTHLY
  QUARTERLY
  SEMI_ANNUALLY
  ANNUALLY
}

enum ReviewOutcome {
  EFFECTIVE
  NEEDS_IMPROVEMENT
  INEFFECTIVE
}

enum EvidenceKind {
  FILE
  LINK
}

enum EvidenceCategory {
  POLICY
  SCREENSHOT
  CONFIGURATION
  REPORT
  LOG
  RECORD
  OTHER
}

enum EvidenceSource {
  MANUAL
  INTEGRATION
}

enum EvidenceStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskSource {
  MANUAL
  GAP
}

enum RiskKind {
  GAP
  RISK
}

enum RiskStatus {
  OPEN
  IN_PROGRESS
  MITIGATED
  ACCEPTED
  CLOSED
}

enum RiskSource {
  MANUAL
  DETECTED
}

enum ActorType {
  USER
  SYSTEM
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  CONTROL_ASSIGNED
  CONTROL_REVIEW_DUE
  EVIDENCE_SUBMITTED_FOR_REVIEW
  EVIDENCE_REVIEWED
  EVIDENCE_EXPIRING
  EVIDENCE_EXPIRED
  RISK_ASSIGNED
  MEMBER_ROLE_CHANGED
  INVITATION_RECEIVED
}

// ─── Identity (first-party auth; see docs/DECISIONS.md) ─────────────────────

model User {
  id            String    @id @default(uuid(7))
  /// Always stored lowercase and trimmed.
  email         String    @unique
  name          String
  emailVerified Boolean   @default(false)
  image         String?
  lastLoginAt   DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)

  account       Account?
  sessions      Session[]
  verifications Verification[]
  memberships   OrganizationMember[]

  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsAccepted Invitation[] @relation("InvitationAcceptedBy")

  frameworksAdopted OrganizationFramework[]

  controlsOwned     Control[]         @relation("ControlOwner")
  controlsCreated   Control[]         @relation("ControlCreatedBy")
  controlReviews    ControlReview[]
  evidenceUploaded  Evidence[]        @relation("EvidenceUploadedBy")
  evidenceReviewed  Evidence[]        @relation("EvidenceReviewedBy")
  evidenceDeleted   Evidence[]        @relation("EvidenceDeletedBy")
  evidenceVersions  EvidenceVersion[]
  evidenceLinks     ControlEvidence[]

  tasksAssigned  Task[] @relation("TaskAssignee")
  tasksCreated   Task[] @relation("TaskCreatedBy")
  tasksCompleted Task[] @relation("TaskCompletedBy")

  risksOwned    Risk[] @relation("RiskOwner")
  risksCreated  Risk[] @relation("RiskCreatedBy")
  risksResolved Risk[] @relation("RiskResolvedBy")

  notifications Notification[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_name_trgm_idx")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "User_email_trgm_idx")
}

/// Password credential. One per user (email + password is the only sign-in method in the MVP).
model Account {
  id           String   @id @default(uuid(7))
  userId       String   @unique
  /// scrypt hash in the format scrypt$N$r$p$salt$hash (see src/server/auth/password.ts).
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Session {
  id           String    @id @default(uuid(7))
  userId       String
  /// HMAC-SHA256 of the opaque cookie token. The raw token is never stored.
  tokenHash    String    @unique
  expiresAt    DateTime  @db.Timestamptz(3)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
}

/// Single-use tokens (password reset). Only an HMAC of the token is stored.
model Verification {
  id         String    @id @default(uuid(7))
  userId     String
  purpose    String
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Organization {
  id            String        @id @default(uuid(7))
  name          String
  slug          String        @unique
  legalName     String?
  website       String?
  industry      String?
  employeeRange EmployeeRange @default(R1_10)
  description   String?

  auditType        AuditType @default(UNDECIDED)
  targetAuditDate  DateTime? @db.Date
  observationStart DateTime? @db.Date
  observationEnd   DateTime? @db.Date

  timezone                         String  @default("UTC")
  requireIndependentEvidenceReview Boolean @default(true)
  defaultEvidenceValidityDays      Int     @default(365)
  isDemo                           Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members              OrganizationMember[]
  invitations          Invitation[]
  counters             OrganizationCounter[]
  frameworks           OrganizationFramework[]
  controls             Control[]
  controlRequirements  ControlRequirement[]
  controlReviews       ControlReview[]
  evidenceRequirements EvidenceRequirement[]
  evidence             Evidence[]
  evidenceVersions     EvidenceVersion[]
  controlEvidence      ControlEvidence[]
  tasks                Task[]
  taskControls         TaskControl[]
  risks                Risk[]
  riskControls         RiskControl[]
  notifications        Notification[]
}

model OrganizationMember {
  id             String   @id @default(uuid(7))
  organizationId String
  userId         String
  role           Role
  title          String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Invitation {
  id             String    @id @default(uuid(7))
  organizationId String
  /// Always stored lowercase.
  email          String
  role           Role
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime  @db.Timestamptz(3)
  acceptedAt     DateTime? @db.Timestamptz(3)
  acceptedById   String?
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy   User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([email])
}

model OrganizationCounter {
  organizationId String
  /// "task" | "risk"
  key            String
  value          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, key])
}

// ─── Framework catalog (global, synced from code by `npm run catalog:sync`) ──

model Framework {
  id                    String  @id @default(uuid(7))
  key                   String  @unique
  name                  String
  shortName             String
  version               String
  description           String
  requirementLabel      String
  requirementShortLabel String
  isActive              Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  requirements            FrameworkRequirement[]
  controlTemplates        ControlTemplate[]
  organizationAdoptions   OrganizationFramework[]
}

model FrameworkRequirement {
  id              String          @id @default(uuid(7))
  frameworkId     String
  parentId        String?
  code            String
  title           String
  summary         String
  kind            RequirementKind
  /// For top-level GROUPs: the category is always in scope and cannot be deselected.
  isScopeRequired Boolean         @default(false)
  sortOrder       Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  framework Framework              @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  parent    FrameworkRequirement?  @relation("RequirementTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  FrameworkRequirement[] @relation("RequirementTree")

  templateMappings ControlTemplateRequirement[]
  controlMappings  ControlRequirement[]
  scopes           OrganizationFrameworkScope[]

  @@unique([frameworkId, code])
  @@index([frameworkId, parentId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "FrameworkRequirement_title_trgm_idx")
}

model ControlTemplate {
  id                     String          @id @default(uuid(7))
  frameworkId            String
  code                   String
  name                   String
  description            String
  guidance               String
  domain                 String
  defaultPriority        Priority
  defaultReviewFrequency ReviewFrequency
  sortOrder              Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  framework            Framework                     @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  requirements         ControlTemplateRequirement[]
  evidenceRequirements EvidenceRequirementTemplate[]
  controls             Control[]

  @@unique([frameworkId, code])
}

model ControlTemplateRequirement {
  controlTemplateId String
  requirementId     String

  controlTemplate ControlTemplate      @relation(fields: [controlTemplateId], references: [id], onDelete: Cascade)
  requirement     FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@id([controlTemplateId, requirementId])
}

model EvidenceRequirementTemplate {
  id                String  @id @default(uuid(7))
  controlTemplateId String
  /// Stable key within the template, used by catalog sync to upsert.
  key               String
  title             String
  description       String
  freshnessDays     Int
  isRequired        Boolean @default(true)
  sortOrder         Int

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  controlTemplate      ControlTemplate       @relation(fields: [controlTemplateId], references: [id], onDelete: Restrict)
  evidenceRequirements EvidenceRequirement[]

  @@unique([controlTemplateId, key])
}

// ─── Organization compliance ────────────────────────────────────────────────

model OrganizationFramework {
  id             String   @id @default(uuid(7))
  organizationId String
  frameworkId    String
  adoptedAt      DateTime @default(now()) @db.Timestamptz(3)
  adoptedById    String
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  framework    Framework                    @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  adoptedBy    User                         @relation(fields: [adoptedById], references: [id], onDelete: Restrict)
  scopes       OrganizationFrameworkScope[]

  @@unique([organizationId, frameworkId])
}

model OrganizationFrameworkScope {
  organizationFrameworkId String
  /// A top-level GROUP requirement (category) that is in scope.
  requirementId           String
  createdAt               DateTime @default(now()) @db.Timestamptz(3)

  organizationFramework OrganizationFramework @relation(fields: [organizationFrameworkId], references: [id], onDelete: Cascade)
  requirement           FrameworkRequirement  @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@id([organizationFrameworkId, requirementId])
}

model Control {
  id                  String          @id @default(uuid(7))
  organizationId      String
  code                String
  name                String
  description         String
  implementationNotes String?
  notes               String?
  domain              String?
  status              ControlStatus   @default(NOT_STARTED)
  notApplicableReason String?
  priority            Priority        @default(MEDIUM)
  ownerId             String?
  reviewFrequency     ReviewFrequency @default(ANNUALLY)
  nextReviewDate      DateTime?       @db.Date
  lastReviewedAt      DateTime?       @db.Timestamptz(3)
  templateId          String?
  createdById         String
  archivedAt          DateTime?       @db.Timestamptz(3)
  version             Int             @default(1)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?            @relation("ControlOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("ControlCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  template     ControlTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  requirements         ControlRequirement[]
  reviews              ControlReview[]
  evidenceRequirements EvidenceRequirement[]
  evidenceLinks        ControlEvidence[]
  taskLinks            TaskControl[]
  riskLinks            RiskControl[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  /// A template is instantiated at most once per organization (adoption is idempotent).
  @@unique([organizationId, templateId])
  @@index([organizationId, status])
  @@index([organizationId, ownerId])
  @@index([organizationId, nextReviewDate])
  @@index([organizationId, archivedAt])
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "Control_code_trgm_idx")
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Control_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Control_description_trgm_idx")
}

model ControlRequirement {
  id             String   @id @default(uuid(7))
  organizationId String
  controlId      String
  requirementId  String
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  control      Control              @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)
  requirement  FrameworkRequirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@unique([controlId, requirementId])
  @@index([organizationId, requirementId])
}

model ControlReview {
  id             String        @id @default(uuid(7))
  organizationId String
  controlId      String
  reviewerId     String
  reviewedAt     DateTime      @default(now()) @db.Timestamptz(3)
  outcome        ReviewOutcome
  notes          String
  nextReviewDate DateTime      @db.Date
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  control      Control      @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([organizationId, controlId, reviewedAt])
}

model EvidenceRequirement {
  id             String    @id @default(uuid(7))
  organizationId String
  controlId      String
  title          String
  description    String?
  freshnessDays  Int
  isRequired     Boolean   @default(true)
  templateId     String?
  sortOrder      Int       @default(0)
  archivedAt     DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  control      Control                      @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)
  template     EvidenceRequirementTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  links        ControlEvidence[]

  @@unique([organizationId, id])
  @@unique([id, controlId], map: "EvidenceRequirement_id_control_key")
  @@index([organizationId, controlId])
}

model Evidence {
  id               String           @id @default(uuid(7))
  organizationId   String
  title            String
  description      String?
  kind             EvidenceKind
  category         EvidenceCategory
  url              String?
  source           EvidenceSource   @default(MANUAL)
  status           EvidenceStatus   @default(PENDING_REVIEW)
  collectedAt      DateTime         @db.Date
  validUntil       DateTime?        @db.Date
  currentVersionId String?          @unique
  uploadedById     String
  reviewedById     String?
  reviewedAt       DateTime?        @db.Timestamptz(3)
  reviewComment    String?
  deletedAt        DateTime?        @db.Timestamptz(3)
  deletedById      String?
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy     User             @relation("EvidenceUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)
  reviewedBy     User?            @relation("EvidenceReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)
  deletedBy      User?            @relation("EvidenceDeletedBy", fields: [deletedById], references: [id], onDelete: Restrict)
  currentVersion EvidenceVersion? @relation("EvidenceCurrentVersion", fields: [currentVersionId], references: [id], onDelete: Restrict)
  versions       EvidenceVersion[] @relation("EvidenceVersions")
  controlLinks   ControlEvidence[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, validUntil])
  @@index([organizationId, deletedAt])
  @@index([organizationId, uploadedById])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Evidence_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "Evidence_description_trgm_idx")
}

model EvidenceVersion {
  id               String   @id @default(uuid(7))
  organizationId   String
  evidenceId       String
  versionNumber    Int
  storageKey       String   @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  sha256           String
  uploadedById     String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  evidence     Evidence     @relation("EvidenceVersions", fields: [organizationId, evidenceId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  currentOf    Evidence?    @relation("EvidenceCurrentVersion")

  @@unique([evidenceId, versionNumber])
  @@index([organizationId, evidenceId])
  @@index([originalFilename(ops: raw("gin_trgm_ops"))], type: Gin, map: "EvidenceVersion_filename_trgm_idx")
}

model ControlEvidence {
  id                    String   @id @default(uuid(7))
  organizationId        String
  controlId             String
  evidenceId            String
  evidenceRequirementId String?
  linkedById            String
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  control             Control              @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)
  evidence            Evidence             @relation(fields: [organizationId, evidenceId], references: [organizationId, id], onDelete: Restrict)
  /// Composite FK: a requirement-specific link must point at a requirement of the same control.
  evidenceRequirement EvidenceRequirement? @relation(fields: [evidenceRequirementId, controlId], references: [id, controlId], onDelete: Restrict, map: "ControlEvidence_requirement_same_control_fkey")
  linkedBy            User                 @relation(fields: [linkedById], references: [id], onDelete: Restrict)

  // Duplicate links are prevented by partial unique indexes in the raw-SQL migration:
  // (controlId, evidenceId) WHERE evidenceRequirementId IS NULL, and
  // (evidenceRequirementId, evidenceId) WHERE evidenceRequirementId IS NOT NULL.
  @@index([organizationId, controlId])
  @@index([organizationId, evidenceId])
  @@index([evidenceRequirementId])
}

// ─── Work management ────────────────────────────────────────────────────────

model Task {
  id             String     @id @default(uuid(7))
  organizationId String
  number         Int
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  assigneeId     String?
  createdById    String
  dueDate        DateTime?  @db.Date
  completedAt    DateTime?  @db.Timestamptz(3)
  completedById  String?
  riskId         String?
  source         TaskSource @default(MANUAL)
  gapKey         String?
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  completedBy  User?         @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: Restrict)
  risk         Risk?         @relation(fields: [riskId], references: [id], onDelete: Restrict)
  controls     TaskControl[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, assigneeId, status])
  @@index([organizationId, gapKey])
  @@index([organizationId, riskId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Task_title_trgm_idx")
}

model TaskControl {
  id             String @id @default(uuid(7))
  organizationId String
  taskId         String
  controlId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Tasks may be hard-deleted; their control links go with them. The audit event keeps a snapshot.
  task         Task         @relation(fields: [organizationId, taskId], references: [organizationId, id], onDelete: Cascade)
  control      Control      @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)

  @@unique([taskId, controlId])
  @@index([organizationId, controlId])
}

model Risk {
  id              String     @id @default(uuid(7))
  organizationId  String
  number          Int
  title           String
  description     String?
  kind            RiskKind   @default(RISK)
  severity        Priority   @default(MEDIUM)
  status          RiskStatus @default(OPEN)
  ownerId         String?
  dueDate         DateTime?  @db.Date
  treatmentPlan   String?
  resolutionNotes String?
  resolvedAt      DateTime?  @db.Timestamptz(3)
  resolvedById    String?
  source          RiskSource @default(MANUAL)
  gapKey          String?
  archivedAt      DateTime?  @db.Timestamptz(3)
  createdById     String
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  owner        User?         @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  resolvedBy   User?         @relation("RiskResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)
  createdBy    User          @relation("RiskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  controls     RiskControl[]
  tasks        Task[]

  @@unique([organizationId, number])
  @@unique([organizationId, id])
  @@index([organizationId, status, severity])
  @@index([organizationId, gapKey])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Risk_title_trgm_idx")
}

model RiskControl {
  id             String @id @default(uuid(7))
  organizationId String
  riskId         String
  controlId      String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  risk         Risk         @relation(fields: [organizationId, riskId], references: [organizationId, id], onDelete: Restrict)
  control      Control      @relation(fields: [organizationId, controlId], references: [organizationId, id], onDelete: Restrict)

  @@unique([riskId, controlId])
  @@index([organizationId, controlId])
}

// ─── Audit trail and notifications ──────────────────────────────────────────

/// Append-only. A database trigger rejects UPDATE and DELETE (see the raw-SQL migration).
/// No foreign keys: resourceId is polymorphic and snapshot fields keep events meaningful.
model AuditEvent {
  id             String    @id @default(uuid(7))
  /// "org:<organizationId>" or "user:<userId>"
  chainKey       String
  sequence       BigInt
  organizationId String?
  occurredAt     DateTime  @db.Timestamptz(3)

  actorType   ActorType
  actorUserId String?
  actorEmail  String?
  actorName   String?
  actorRole   String?

  action        String
  resourceType  String
  resourceId    String?
  resourceLabel String?
  changes       Json?
  metadata      Json?

  ipAddress String?
  userAgent String?
  requestId String?

  prevHash String?
  hash     String

  @@unique([chainKey, sequence])
  @@index([organizationId, occurredAt])
  @@index([organizationId, resourceType, resourceId])
  @@index([organizationId, actorUserId, occurredAt])
  @@index([organizationId, action])
}

model AuditChainHead {
  chainKey     String   @id
  lastSequence BigInt   @default(0)
  lastHash     String?
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

model Notification {
  id             String           @id @default(uuid(7))
  organizationId String
  recipientId    String
  type           NotificationType
  title          String
  body           String?
  linkPath       String
  resourceType   String?
  resourceId     String?
  dedupeKey      String?
  readAt         DateTime?        @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    User         @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, createdAt])
  @@index([organizationId, recipientId, createdAt])
}

// ─── Infrastructure ─────────────────────────────────────────────────────────

/// Fixed-window rate-limit counters, incremented atomically with INSERT ... ON CONFLICT.
model RateLimitBucket {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int
}
