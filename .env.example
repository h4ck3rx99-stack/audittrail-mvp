# ─────────────────────────────────────────────────────────────────────────────
# AuditTrail configuration. Copy to .env and adjust. Every variable is validated
# at startup by src/env.ts; the app refuses to boot with an invalid config.
# ─────────────────────────────────────────────────────────────────────────────

# "local" for laptops/CI, "production" for real deployments. Production turns on strict
# checks: no local storage driver, no console email, https APP_URL, CRON_SECRET required,
# and the demo seed refuses to run unless ALLOW_DEMO_SEED=true.
DEPLOYMENT_ENV=local

# ── Core ─────────────────────────────────────────────────────────────────────
# Postgres connection (docker compose publishes Postgres on host port 5433).
DATABASE_URL=postgresql://audittrail:audittrail@localhost:5433/audittrail
# Separate database used by the integration test suite. It is TRUNCATEd between tests.
# docker compose creates it on first start (docker/postgres-init/01-test-db.sql).
DATABASE_URL_TEST=postgresql://audittrail:audittrail@localhost:5433/audittrail_test
# Secret used to HMAC session, password-reset and invitation tokens before storage (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-at-least-32-random-characters-0000
# Public origin of the app (no trailing slash). Used for links in emails and for Origin checks
# on mutating route handlers. Session cookies get the Secure flag when this is https.
APP_URL=http://localhost:3000

# ── Evidence storage ─────────────────────────────────────────────────────────
# local = filesystem (development only), s3 = any S3-compatible store (S3, R2, MinIO).
STORAGE_DRIVER=local
# Directory for the local driver. Must be outside public/. Git-ignored.
STORAGE_LOCAL_DIR=./storage
# S3-compatible settings (required when STORAGE_DRIVER=s3). For MinIO started with
# `docker compose --profile minio up -d` use S3_ENDPOINT=http://localhost:9000 and path style.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Hard cap for a single evidence upload, in megabytes.
MAX_UPLOAD_MB=25

# ── Email ────────────────────────────────────────────────────────────────────
# console = print emails (including links) to the server log; smtp; or resend.
EMAIL_DRIVER=console
EMAIL_FROM="AuditTrail <no-reply@audittrail.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ── Operations ───────────────────────────────────────────────────────────────
# Bearer token for POST /api/cron/compliance-scan (min 16 chars). Required in production.
CRON_SECRET=replace-me-with-a-long-random-cron-secret
# Number of trusted reverse proxies in front of the app (1 behind a single load balancer).
# 0 = never read X-Forwarded-For: client IPs are unknown and per-IP rate limits share one bucket.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Must be true to run the demo seed when DEPLOYMENT_ENV=production.
ALLOW_DEMO_SEED=false
